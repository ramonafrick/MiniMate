@using MiniMate.Modules.Location.UI.Components
@using MiniMate.Modules.Profile.UI.Components
@using MiniMate.Modules.Weather.UI.Components
@using MiniMate.Modules.Calendar.UI.Components
@using MiniMate.Modules.Clothing.UI.Components

<Router AppAssembly="@typeof(App).Assembly"
        AdditionalAssemblies="new[] {
            typeof(LocationSearchComponent).Assembly,
            typeof(ProfileComponent).Assembly,
            typeof(MiniMate.Modules.Weather.UI.Components.WeatherComponent).Assembly,
            typeof(MiniMate.Modules.Calendar.UI.Components.DateTimeComponent).Assembly,
            typeof(MiniMate.Modules.Clothing.UI.Components.WeatherAvatarComponent).Assembly
        }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
