<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>MiniMate.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>MiniMate.Maui</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.minimate.maui</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

        <!-- Android Package Format: apk (for direct install) or aab (for Play Store) -->
        <AndroidPackageFormat>apk</AndroidPackageFormat>
    </PropertyGroup>

    <!-- Android-specific configuration for Debug builds (optimized for emulator) -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Debug'">
        <!-- Disable linking for faster builds and easier debugging -->
        <AndroidLinkMode>None</AndroidLinkMode>

        <!-- Disable AOT compilation for faster deployment -->
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RunAOTCompilation>false</RunAOTCompilation>

        <!-- Enable Fast Deployment for emulator -->
        <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk>

        <!-- Use shared runtime for faster deployment -->
        <AndroidUseSharedRuntime>true</AndroidUseSharedRuntime>

        <!-- Enable incremental builds -->
        <AndroidEnableMultiDex>false</AndroidEnableMultiDex>

        <!-- Use interpreter for faster startup in emulator -->
        <UseInterpreter>true</UseInterpreter>
    </PropertyGroup>

    <!-- Android-specific configuration for Release builds (for physical devices and Play Store) -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
        <!-- Enable linking to reduce app size -->
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>

        <!-- Disable AOT for compatibility (can be enabled if needed) -->
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RunAOTCompilation>false</RunAOTCompilation>

        <!-- Embed assemblies for physical device deployment -->
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

        <!-- Don't use shared runtime for release builds -->
        <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>

        <!-- Use AAPT2 for better resource optimization -->
        <AndroidUseAapt2>true</AndroidUseAapt2>

        <!-- Don't create per-ABI packages by default -->
        <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Images\splash_logo.png" Color="#4A90E2" BaseSize="256,256" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

        <!-- Include wwwroot assets from Clothing module -->
        <MauiAsset Include="..\Modules\MiniMate.Modules.Clothing\wwwroot\**\*.*">
            <LogicalName>_content\MiniMate.Modules.Clothing\%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </MauiAsset>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Modules\MiniMate.Modules.Home\MiniMate.Modules.Home.csproj" />
        <ProjectReference Include="..\Modules\MiniMate.Modules.Location\MiniMate.Modules.Location.csproj" />
        <ProjectReference Include="..\Modules\MiniMate.Modules.Weather\MiniMate.Modules.Weather.csproj" />
        <ProjectReference Include="..\Modules\MiniMate.Modules.Clothing\MiniMate.Modules.Clothing.csproj" />
        <ProjectReference Include="..\Modules\MiniMate.Modules.Calendar\MiniMate.Modules.Calendar.csproj" />
        <ProjectReference Include="..\Modules\MiniMate.Modules.Profile\MiniMate.Modules.Profile.csproj" />
    </ItemGroup>

</Project>
